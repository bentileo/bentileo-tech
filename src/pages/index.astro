---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} active="home">
  <section class="sechead">
    <h1 class="display">Five years at the bedside taught me which questions matter. Data science is how I answer them.</h1>
    <p class="lede">
      I am a physiologist and data scientist with five years in cardiovascular,
      pulmonary and metabolic care, now building evaluation benchmarks, forecasting
      models and data tools for clinical and financial decisions.
    </p>
  </section>

  <section class="sechead">
    <p class="lab">Projects</p>
  </section>
  <div class="grid2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>
