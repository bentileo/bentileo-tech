---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title={`Projects | ${SITE_TITLE}`}
  description="Data science projects in cardiac care: price benchmarks, revenue forecasting and ECG screening."
  active="projects"
>
  <section class="sechead">
    <p class="lab">Projects</p>
    <h1 class="display">Built in the open, from public data.</h1>
    <p class="lede">
      Each project has a write-up covering the problem, the data, the decisions and
      their reasons, and what the data cannot say. Status reflects what is built,
      not what is planned.
    </p>
  </section>
  <div class="grid2">
    {projects.map((project) => <ProjectCard project={project} long />)}
  </div>
</Base>
