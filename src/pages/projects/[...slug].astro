---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, summary, status, statusLabel, stack, data, scope, period, repo, demo } =
  project.data;
const { Content } = await render(project);
---

<Base title={`${title} | ${SITE_TITLE}`} description={summary} active="projects">
  <a class="back" href="/projects/">&larr; Projects</a>
  <h1 class="case">{title}</h1>
  <p class="summary">{summary}</p>

  <dl class="metabox">
    <dt>Status</dt>
    <dd class={status === 'live' ? 'live' : undefined}>{statusLabel}</dd>
    <dt>Stack</dt>
    <dd>{stack}</dd>
    {data && (<><dt>Data</dt><dd>{data}</dd></>)}
    {scope && (<><dt>Scope</dt><dd>{scope}</dd></>)}
    {period && (<><dt>Period</dt><dd>{period}</dd></>)}
  </dl>

  {(demo || repo) && (
    <div class="actions">
      {demo && <a class="btn" href={demo}>Try the demo</a>}
      {repo && <a class="btn ghost" href={repo}>Source code</a>}
    </div>
  )}

  <article class="prose">
    <Content />
  </article>
</Base>

<style is:global>
  .back {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    color: var(--dim);
    text-decoration: none;
    display: inline-block;
    margin: 44px 0 0;
  }
  h1.case { font-size: 40px; margin: 14px 0 0; }
  .summary { font-size: 20px; color: var(--dim); margin: 18px 0 0; max-width: 55ch; }

  .metabox {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 20px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    margin: 26px 0 0;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .metabox dt { color: var(--dim); letter-spacing: .04em; }
  .metabox dd { margin: 0; }
  .metabox dd.live { color: var(--signal); font-weight: 500; }

  .actions {
    display: flex;
    gap: 10px;
    margin: 22px 0 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13.5px;
  }
  .btn {
    padding: 9px 18px;
    background: var(--signal);
    color: #fff;
    text-decoration: none;
    border-radius: 3px;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule);
  }

  /* --- rendered markdown --- */
  .prose h2 {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 27px;
    font-weight: 700;
    text-transform: none;
    letter-spacing: -.01em;
    color: var(--ink);
    margin: 52px 0 0;
    line-height: 1.3;
  }
  .prose h3 { font-size: 20px; font-weight: 600; margin: 34px 0 0; line-height: 1.35; }
  .prose p { margin: 16px 0 0; max-width: 62ch; }
  .prose ul { margin: 16px 0 0; padding-left: 22px; max-width: 62ch; }
  .prose li { margin-bottom: 8px; }

  .prose .note {
    border-left: 3px solid var(--signal);
    background: var(--signal-soft);
    padding: 16px 20px;
    margin: 26px 0 0;
    font-size: 17px;
  }
  .prose .q {
    font-size: 19px;
    margin: 18px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--rule);
    color: var(--dim);
  }
  .prose .flow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    line-height: 1.9;
    border: 1px solid var(--rule);
    padding: 20px 24px;
    margin: 26px 0 0;
    color: var(--dim);
    background: rgba(255, 255, 255, .5);
  }
  .prose .flow b { color: var(--ink); font-weight: 500; }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 0;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14.5px;
  }
  .prose th {
    text-align: left;
    font-weight: 600;
    color: var(--dim);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 0 0 9px;
    border-bottom: 1px solid var(--rule);
  }
  .prose td {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
    vertical-align: top;
  }
  .prose td:first-child { padding-right: 20px; }
  .prose td:not(:first-child),
  .prose th:not(:first-child) { text-align: right; }
  /* The data table on the analytics page reads better left-aligned. */
  .prose table:has(th:nth-child(2):last-child) td:not(:first-child),
  .prose table:has(th:nth-child(2):last-child) th:not(:first-child) {
    text-align: left;
  }

  .prose figure { margin: 32px 0 0; }
  .prose figure svg {
    width: 100%;
    display: block;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .prose figcaption {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12.5px;
    color: var(--dim);
    margin-top: 9px;
  }
</style>
