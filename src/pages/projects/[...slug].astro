---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { title, summary, status, statusLabel, data, scope, period, repo, demo } =
  project.data;
const { Content } = await render(project);
---

<Base title={`${title} | ${SITE_TITLE}`} description={summary} active="home">
  <a class="back" href="/">&larr; Home</a>
  <section class="sechead case">
    <p class="lab">{project.data.kicker ?? 'Project'}</p>
    <h1 class="display">{title}</h1>
    <p class="lede">{summary}</p>
  </section>

  <div class="kpis metabox">
    <div class="kpi"><span class="lab">Status</span><span class={`s big ${status === 'live' ? 'live' : ''}`}>{statusLabel}</span></div>
    {data && <div class="kpi"><span class="lab">Data</span><span class="s big">{data}</span></div>}
    {scope && <div class="kpi"><span class="lab">Scope</span><span class="s big">{scope}</span></div>}
    {period && <div class="kpi"><span class="lab">Period</span><span class="s big">{period}</span></div>}
  </div>

  {(demo || repo) && (
    <div class="actions">
      {demo && <a class="btn primary" href={demo}>{project.data.demoLabel ?? 'Open'}</a>}
      {repo && <a class="btn" href={repo}>Source code</a>}
    </div>
  )}

  <article class="prose">
    <Content />
  </article>
</Base>

<style is:global>
  .back { font-size: 13px; color: var(--muted); text-decoration: none; display: inline-block; margin: 28px 0 0; }
  .back:hover { color: var(--ink); }
  .sechead.case { margin-top: 10px; }
  .metabox .kpi .s.big { font-size: 14px; color: var(--ink); line-height: 1.45; }
  .metabox .kpi .s.live { color: var(--signal); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 22px 0 0; }

  /* --- rendered markdown --- */
  .prose { max-width: 76ch; font-size: 16.5px; line-height: 1.65; }
  .prose h2 {
    font-family: var(--serif);
    font-size: 27px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: -.01em;
    color: var(--ink);
    margin: 52px 0 0;
    line-height: 1.3;
  }
  .prose h3 { font-size: 20px; font-weight: 600; margin: 34px 0 0; line-height: 1.35; }
  .prose p { margin: 16px 0 0; max-width: 62ch; }
  .prose ul { margin: 16px 0 0; padding-left: 22px; max-width: 62ch; }
  .prose li { margin-bottom: 8px; }

  .prose .note {
    border-left: 3px solid var(--blue);
    background: var(--blue-soft);
    padding: 16px 20px;
    margin: 26px 0 0;
    font-size: 17px;
  }
  .prose .q {
    font-size: 19px;
    margin: 18px 0 0;
    padding-left: 20px;
    border-left: 2px solid var(--rule);
    color: var(--dim);
  }
  .prose .flow {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.9;
    border: 1px solid var(--rule);
    padding: 20px 24px;
    margin: 26px 0 0;
    color: var(--dim);
    background: var(--surface);
  }
  .prose .flow b { color: var(--ink); font-weight: 500; }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0 0;
    font-family: var(--sans);
    font-size: 14.5px;
  }
  .prose th {
    text-align: left;
    font-weight: 600;
    color: var(--dim);
    font-size: 11.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 0 0 9px;
    border-bottom: 1px solid var(--rule);
  }
  .prose td {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
    vertical-align: top;
  }
  .prose td:first-child { padding-right: 20px; }
  .prose td:not(:first-child),
  .prose th:not(:first-child) { text-align: right; }
  /* The data table on the analytics page reads better left-aligned. */
  .prose table:has(th:nth-child(2):last-child) td:not(:first-child),
  .prose table:has(th:nth-child(2):last-child) th:not(:first-child) {
    text-align: left;
  }

  .prose figure { margin: 32px 0 0; }
  .prose figure svg {
    width: 100%;
    display: block;
    background: #fff;
    border: 1px solid var(--rule);
  }
  .prose figcaption {
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--dim);
    margin-top: 9px;
  }
</style>
