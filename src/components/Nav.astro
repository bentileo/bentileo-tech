---
import { GITHUB_URL, LINKEDIN_URL, SITE_TAGLINE, SITE_TITLE } from '../consts';

interface Props {
  active?: 'home' | 'projects';
}

const { active } = Astro.props;
---

<nav class="mast" aria-label="Site">
  <span class="name"><a href="/">{SITE_TITLE}</a><small>{SITE_TAGLINE}</small></span>
  <span class="links">
    <a href={GITHUB_URL}>GitHub</a>
    <a href={LINKEDIN_URL}>LinkedIn</a>
    <a href="#" class="mail">Email</a>
  </span>
</nav>
