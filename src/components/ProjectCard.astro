---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  // The projects index shows the longer description.
  long?: boolean;
}

const { project, long = false } = Astro.props;
const { title, summary, detail, status, statusLabel, stack, data, period, demo, repo, kicker } =
  project.data;
---

<article class="panel">
  <span class="lab">{kicker ?? 'Project'}</span>
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  <p>{long && detail ? detail : summary}</p>
  <span class={`status ${status === 'live' ? 'live' : ''}`}><i></i>{demo ? <a href={demo}>{statusLabel}</a> : statusLabel}</span>
  <table class="meta">
    <tbody>
      <tr><td>Stack</td><td>{stack}</td></tr>
      {data && <tr><td>Data</td><td>{data}</td></tr>}
      {period && <tr><td>Period</td><td>{period}</td></tr>}
    </tbody>
  </table>
  <div class="actions">
    <a class="btn primary" href={`/projects/${project.id}/`}>Read the write-up</a>
    {demo && <a class="btn" href={demo}>Open</a>}
    {repo && <a class="btn" href={repo}>Code</a>}
  </div>
</article>
